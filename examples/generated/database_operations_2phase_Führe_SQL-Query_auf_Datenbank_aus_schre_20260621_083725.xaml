  <TryCatch DisplayName="ExportSQLToExcel TryCatch">
    <TryCatch.Try>
      <Sequence DisplayName="Main Process">
        <Sequence.Variables>
          <Variable x:TypeArguments="System.Data.DataTable" Name="dataTable" />
          <Variable x:TypeArguments="System.String" Name="excelFilePath" Default="" />
        </Sequence.Variables>
        <ui:LogMessage DisplayName="Log Start" Level="Information" Message="[ExportSQLToExcel] Start - in_ConnectionString, in_Query" />
              <ui:Connect DisplayName="Datenbank verbinden" ConnectionString="[in_ConnectionString]" DatabaseConnection="[db_Connection]" ProviderName="System.Data.SqlClient" />
              <ui:ExecuteQuery ContinueOnError="False" DisplayName="SQL-Query ausführen" ConnectionString="[in_ConnectionString]" Sql="[in_Query]" CommandType="Text" TimeoutMS="30000">
                <ui:ExecuteQuery.Result>
                  <OutArgument x:TypeArguments="sd:DataTable">[dt_QueryResult]</OutArgument>
                </ui:ExecuteQuery.Result>
              </ui:ExecuteQuery>
              <ui:LogMessage DisplayName="Excel-Pfad setzen [TODO: Implementieren]" Level="Warning" Message="[ExportSQLToExcel] SCHRITT AUSSTEHEND: Excel-Pfad setzen (Assign)" />
              <ui:WriteRange DisplayName="Ergebnis in Excel schreiben" WorkbookPath="[in_ExcelFilePath]" SheetName="Sheet1" StartingCell="=dataTable" DataTable="[io_DataTable]" AddHeaders="False" />
        <ui:LogMessage DisplayName="Log Ende" Level="Information" Message="[ExportSQLToExcel] Abgeschlossen" />
      </Sequence>
    </TryCatch.Try>
    <TryCatch.Catches>
      <Catch x:TypeArguments="s:Exception" faultVariable="exception">
        <ActivityAction x:TypeArguments="s:Exception">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Fehlerbehandlung">
            <ui:TakeScreenshot DisplayName="Screenshot bei Fehler" FileName="[&quot;Screenshot_&quot; + DateTime.Now.ToString(&quot;yyyyMMdd_HHmmss&quot;) + &quot;.png&quot;]" />
            <ui:LogMessage DisplayName="Log Fehler" Level="Error"
              Message="[&quot;[ExportSQLToExcel] FEHLER: &quot; + exception.Message]" />
            <Rethrow DisplayName="Exception weiterleiten" />
          </Sequence>
        </ActivityAction>
      </Catch>
    </TryCatch.Catches>
    <TryCatch.Finally>
      <Sequence DisplayName="Finally – Cleanup">
        <ui:LogMessage DisplayName="Cleanup" Level="Information" Message="[ExportSQLToExcel] Ressourcen freigeben" />
      </Sequence>
    </TryCatch.Finally>
  </TryCatch>
</Activity>
