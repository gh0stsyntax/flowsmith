  <TryCatch DisplayName="RenameAndMovePDFs TryCatch">
    <TryCatch.Try>
      <Sequence DisplayName="Main Process">
        <Sequence.Variables>
          <Variable x:TypeArguments="s:DateTime" Name="today" />
          <Variable x:TypeArguments="x:Object" Name="pdfFiles" />
          <Variable x:TypeArguments="x:String" Name="in_FilePath" />
          <Variable x:TypeArguments="x:String" Name="str_FileContent" />
          <Variable x:TypeArguments="sd:DataTable" Name="io_DataTable" />
        </Sequence.Variables>
        <ui:LogMessage DisplayName="Log Start" Level="Info" Message="[&quot;[RenameAndMovePDFs] Start - in_EingangsOrdner, in_ArchivOrdner&quot;]" />
              <ui:ReadTextFile DisplayName="PDF-Dateien im Eingangsordner lesen" FileName="[in_FilePath]" Content="[str_FileContent]" />
              <ui:ForEachRow DisplayName="Jede PDF-Datei umbenennen und verschieben" DataTable="[io_DataTable]">
                <ui:ForEachRow.Body>
                  <ActivityAction x:TypeArguments="sd:DataRow">
                    <ActivityAction.Argument>
                      <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
                    </ActivityAction.Argument>
                    <ui:LogMessage DisplayName="Row iteration" Level="Info" Message="[&quot;Zeile verarbeiten&quot;]" />
                  </ActivityAction>
                </ui:ForEachRow.Body>
              </ui:ForEachRow>
        <ui:LogMessage DisplayName="Log Ende" Level="Info" Message="[&quot;[RenameAndMovePDFs] Abgeschlossen&quot;]" />
      </Sequence>
    </TryCatch.Try>
    <TryCatch.Catches>
      <Catch x:TypeArguments="s:Exception">
        <ActivityAction x:TypeArguments="s:Exception">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Fehlerbehandlung">
            <ui:LogMessage DisplayName="Log Fehler" Level="Error"
              Message="[&quot;[RenameAndMovePDFs] FEHLER: &quot; + exception.Message]" />
            <Rethrow DisplayName="Exception weiterleiten" />
          </Sequence>
        </ActivityAction>
      </Catch>
    </TryCatch.Catches>
    <TryCatch.Finally>
      <Sequence DisplayName="Finally – Cleanup">
        <ui:LogMessage DisplayName="Cleanup" Level="Info" Message="[&quot;[RenameAndMovePDFs] Ressourcen freigeben&quot;]" />
      </Sequence>
    </TryCatch.Finally>
  </TryCatch>
