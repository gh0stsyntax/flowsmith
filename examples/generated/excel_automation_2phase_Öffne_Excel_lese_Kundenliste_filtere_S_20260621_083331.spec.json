{
  "name": "KundenlisteFiltern",
  "category": "excel_automation",
  "description": "Liest Kundenliste aus Excel, filtert nach Status='Aktiv' und schreibt Ergebnis in neues Sheet 'Auswertung'",
  "packages": [
    "UiPath.System.Activities",
    "UiPath.Excel.Activities"
  ],
  "arguments": [],
  "variables": [
    {
      "name": "excelFilePath",
      "type": "System.String",
      "default": "",
      "scope": "Main"
    },
    {
      "name": "kundenlisteSheet",
      "type": "System.String",
      "default": "Kundenliste",
      "scope": "Main"
    },
    {
      "name": "auswertungSheet",
      "type": "System.String",
      "default": "Auswertung",
      "scope": "Main"
    }
  ],
  "activities": [
    {
      "id": "open_excel",
      "type": "OpenApplication",
      "display_name": "Excel öffnen",
      "props": {
        "FilePath": "[excelFilePath]"
      }
    },
    {
      "id": "read_kundenliste",
      "type": "ReadRange",
      "display_name": "Kundenliste lesen",
      "props": {
        "Address": "[kundenlisteSheet]",
        "Output": "[kundenlisteData]"
      }
    },
    {
      "id": "filter_aktiv",
      "type": "ForEachRow",
      "display_name": "Status='Aktiv' filtern",
      "props": {
        "Input": "[kundenlisteData]",
        "Body": {
          "activities": [
            {
              "id": "check_status",
              "type": "If",
              "display_name": "Status prüfen",
              "props": {
                "Condition": "= [row.Status] == 'Aktiv'",
                "TrueActivity": {
                  "activities": [
                    {
                      "id": "write_row",
                      "type": "WriteRange",
                      "display_name": "Zeile in Auswertung schreiben",
                      "props": {
                        "Address": "[auswertungSheet]",
                        "Input": "[row]"
                      }
                    }
                  ]
                },
                "FalseActivity": {}
              }
            }
          ]
        }
      }
    },
    {
      "id": "save_excel",
      "type": "SaveTextFile",
      "display_name": "Excel speichern",
      "props": {
        "FilePath": "[excelFilePath]",
        "Content": "= [kundenlisteData]"
      }
    }
  ],
  "activity_order": [
    "open_excel",
    "read_kundenliste",
    "filter_aktiv",
    "save_excel"
  ]
}