{
  "name": "WebLoginAndDownloadReport",
  "category": "web_automation",
  "description": "Öffnet Chrome, navigiert zu https://example.com, füllt Login-Formular aus und lädt Bericht herunter.",
  "packages": [
    "UiPath.System.Activities",
    "UiPath.UIAutomation.Activities"
  ],
  "arguments": [],
  "variables": [
    {
      "name": "username",
      "type": "System.String",
      "default": "",
      "scope": "Main"
    },
    {
      "name": "password",
      "type": "System.String",
      "default": "",
      "scope": "Main"
    }
  ],
  "activities": [
    {
      "id": "open_browser",
      "type": "OpenBrowser",
      "display_name": "Chrome öffnen",
      "props": {
        "url": "https://example.com"
      }
    },
    {
      "id": "navigate_to_login",
      "type": "NavigateTo",
      "display_name": "Zu Login navigieren",
      "props": {}
    },
    {
      "id": "fill_username",
      "type": "TypeInto",
      "display_name": "Username einfügen",
      "props": {
        "text": "[username]",
        "target": "//input[@name='username']"
      }
    },
    {
      "id": "fill_password",
      "type": "TypeInto",
      "display_name": "Password einfügen",
      "props": {
        "text": "[password]",
        "target": "//input[@name='password']"
      }
    },
    {
      "id": "submit_login",
      "type": "Click",
      "display_name": "Login submiten",
      "props": {
        "target": "//button[@type='submit']"
      }
    },
    {
      "id": "wait_for_report_link",
      "type": "WaitForElement",
      "display_name": "Bericht-Link warten",
      "props": {
        "selector": "//a[contains(text(), 'Download Report')]"
      }
    },
    {
      "id": "click_report_link",
      "type": "Click",
      "display_name": "Bericht-Link klicken",
      "props": {
        "target": "//a[contains(text(), 'Download Report')]"
      }
    },
    {
      "id": "wait_for_download",
      "type": "WaitForElement",
      "display_name": "Download warten",
      "props": {
        "selector": "//div[@class='download-complete']"
      }
    }
  ],
  "activity_order": [
    "open_browser",
    "navigate_to_login",
    "fill_username",
    "fill_password",
    "submit_login",
    "wait_for_report_link",
    "click_report_link",
    "wait_for_download"
  ]
}