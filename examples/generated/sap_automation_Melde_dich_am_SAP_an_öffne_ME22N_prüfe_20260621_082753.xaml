<?xml version="1.0" encoding="utf-8"?>
<Activity x:Class="SAPAutomation.Workflow"
          xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
          xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
          xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
          xmlns:sap2016="http://schemas.microsoft.com/netfx/2016/xaml/activities/presentation"
          xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
          xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
          xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
          xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
          xmlns:ui="http://schemas.uipath.com/workflow/activities"
          xmlns:uix="http://schemas.uipath.com/workflow/activities/uix"
          xmlns:ue="clr-namespace:UiPath.Excel;assembly=UiPath.Excel.Activities"
          xmlns:ueab="clr-namespace:UiPath.Excel.Activities.Business;assembly=UiPath.Excel.Activities"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          mc:Ignorable="sap sap2010 sap2016 sads">
    <TryCatch DisplayName="Workflow TryCatch">
        <ActivityAction x:TypeArguments="s:Exception" faultVariable="exception">
            <Catch>
                <LogMessage Level="Error" Message="[SAPAutomation.Workflow] FEHLER: {exception.Message}" />
                <Rethrow />
            </Catch>
        </ActivityAction>
        <Finally>
            <!-- Ressourcen freigeben hier einfügen -->
        </Finally>
        <Sequence DisplayName="Main Sequence">
            <LogMessage Level="Info" Message="[SAPAutomation.Workflow] Start" />
            <sap:SapLogin DisplayName="Anmelden am SAP"
                          SapSystemId="{x:Null}"
                          Mandant="{x:Null}"
                          Username="{x:Null}"
                          Password="{x:Null}" />
            <sap:SapOpenTransaction DisplayName="Öffne ME22N"
                                    TransactionCode="ME22N" />
            <!-- Selektor für Bestellpreis und Nettowert einfügen -->
            <LogMessage Level="Info" Message="[SAPAutomation.Workflow] Prüfe Bestellpreis gegen Nettowert" />
            <!-- Logik zur Prüfung der Abweichung einfügen -->
            <If DisplayName="Überprüfe Abweichung">
                <InArgument x:TypeArguments="s:Boolean">[Abweichung > 1%]</InArgument>
                <Then>
                    <LogMessage Level="Info" Message="[SAPAutomation.Workflow] Abweichung > 1%" />
                </Then>
            </If>
            <sap:SapLogout DisplayName="Abmelden am SAP" />
            <LogMessage Level="Info" Message="[SAPAutomation.Workflow] Abgeschlossen" />
        </Sequence>
    </TryCatch>
</Activity>