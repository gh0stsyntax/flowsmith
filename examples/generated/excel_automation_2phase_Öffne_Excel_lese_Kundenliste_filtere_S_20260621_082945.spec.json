{
  "name": "FilterKundenliste",
  "category": "excel_automation",
  "description": "Liest Kundenliste aus Excel, filtert nach Status='Aktiv' und schreibt die Ergebnisse in ein neues Sheet.",
  "packages": [
    "UiPath.System.Activities",
    "UiPath.Excel.Activities"
  ],
  "arguments": [],
  "variables": [
    {
      "name": "excelFilePath",
      "type": "System.String",
      "default": "",
      "scope": "Main"
    },
    {
      "name": "outputSheetName",
      "type": "System.String",
      "default": "Auswertung",
      "scope": "Main"
    }
  ],
  "activities": [
    {
      "id": "open_excel",
      "type": "ExcelApplicationScope",
      "display_name": "Excel öffnen",
      "props": {
        "FilePath": "[excelFilePath]"
      }
    },
    {
      "id": "read_range",
      "type": "ReadRange",
      "display_name": "Kundenliste lesen",
      "props": {
        "Address": "$A$1:$Z$1000",
        "SheetName": "Kundenliste",
        "OutputDataTable": "kundenData"
      }
    },
    {
      "id": "filter_data",
      "type": "Assign",
      "display_name": "Filtern nach Status='Aktiv'",
      "props": {
        "to": "[filteredData]",
        "value": "kundenData.Select(\"Status = 'Aktiv'\").CopyToDataTable()"
      }
    },
    {
      "id": "write_range",
      "type": "WriteRange",
      "display_name": "Ergebnisse in neues Sheet schreiben",
      "props": {
        "Address": "$A$1",
        "SheetName": "[outputSheetName]",
        "InputDataTable": "[filteredData]"
      }
    }
  ],
  "activity_order": [
    "open_excel",
    "read_range",
    "filter_data",
    "write_range"
  ]
}