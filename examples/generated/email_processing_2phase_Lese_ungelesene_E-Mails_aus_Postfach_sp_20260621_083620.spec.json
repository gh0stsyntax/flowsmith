{
  "name": "EmailProcessing",
  "category": "email_processing",
  "description": "Liest ungelesene E-Mails aus Postfach, speichert Anhänge in Ordner und verschiebt verarbeitete Mails.",
  "packages": [
    "UiPath.System.Activities",
    "UiPath.Mail.Activities"
  ],
  "arguments": [],
  "variables": [
    {
      "name": "mails",
      "type": "System.Collections.Generic.List`1[MailMessage]",
      "default": null,
      "scope": "Main"
    },
    {
      "name": "attachmentDir",
      "type": "System.String",
      "default": "",
      "scope": "Main"
    }
  ],
  "activities": [
    {
      "id": "get_mails",
      "type": "GetMailMessages",
      "display_name": "Ungelesene Mails lesen",
      "props": {
        "server": "[emailServer]",
        "username": "[emailUsername]",
        "password": "[emailPassword]",
        "folderName": "INBOX",
        "onlyUnread": true
      }
    },
    {
      "id": "foreach_mail",
      "type": "ForEachRow",
      "display_name": "Jede Mail verarbeiten",
      "props": {
        "collection": "[mails]"
      }
    },
    {
      "id": "save_attachment",
      "type": "CopyFile",
      "display_name": "Anhang speichern",
      "props": {
        "sourcePath": "[currentMail.Attachments[0].FullName]",
        "destinationFolder": "[attachmentDir]"
      }
    },
    {
      "id": "mark_as_read",
      "type": "Assign",
      "display_name": "Mail als gelesen markieren",
      "props": {
        "to": "[currentMail.IsRead]",
        "value": true
      }
    },
    {
      "id": "move_mail",
      "type": "MoveFile",
      "display_name": "Mail verschieben",
      "props": {
        "sourcePath": "[currentMail.FullName]",
        "destinationFolder": "[processedEmailsDir]"
      }
    }
  ],
  "activity_order": [
    "get_mails",
    "foreach_mail",
    "save_attachment",
    "mark_as_read",
    "move_mail"
  ]
}