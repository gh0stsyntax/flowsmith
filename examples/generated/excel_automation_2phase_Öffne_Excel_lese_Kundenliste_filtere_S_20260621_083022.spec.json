{
  "name": "FilterKundenliste",
  "category": "excel_automation",
  "description": "Liest eine Kundenliste aus Excel, filtert nach Status='Aktiv' und schreibt das Ergebnis in ein neues Sheet.",
  "packages": [
    "UiPath.System.Activities",
    "UiPath.Excel.Activities"
  ],
  "arguments": [],
  "variables": [
    {
      "name": "kundenliste",
      "type": "System.Data.DataTable",
      "default": "",
      "scope": "Main"
    },
    {
      "name": "auswertungSheet",
      "type": "Excel.Worksheet",
      "default": "",
      "scope": "Main"
    }
  ],
  "activities": [
    {
      "id": "open_excel",
      "type": "OpenApplication",
      "display_name": "Excel öffnen",
      "props": {
        "FilePath": "C:\\Pfad\\zu\\Kundenliste.xlsx"
      }
    },
    {
      "id": "read_kundenliste",
      "type": "ReadRange",
      "display_name": "Kundenliste lesen",
      "props": {
        "Address": "A1:D100",
        "OutputDataTable": "[kundenliste]"
      }
    },
    {
      "id": "filter_aktiv",
      "type": "ForEachRow",
      "display_name": "Status='Aktiv' filtern",
      "props": {
        "InputTable": "[kundenliste]",
        "ConditionExpression": "row(\"Status\") == \"Aktiv\""
      }
    },
    {
      "id": "write_auswertung",
      "type": "WriteRange",
      "display_name": "Ergebnis in neues Sheet schreiben",
      "props": {
        "Address": "A1:D100",
        "InputTable": "[kundenliste]",
        "SheetName": "Auswertung"
      }
    },
    {
      "id": "close_excel",
      "type": "CloseApplication",
      "display_name": "Excel schließen",
      "props": {}
    }
  ],
  "activity_order": [
    "open_excel",
    "read_kundenliste",
    "filter_aktiv",
    "write_auswertung",
    "close_excel"
  ]
}