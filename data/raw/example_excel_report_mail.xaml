<Activity mc:Ignorable="sap sap2010" x:Class="Example_ExcelReportMail"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
  xmlns:sd="clr-namespace:System.Data;assembly=System.Data"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Neutral example workflow (synthetic, no company data): read an Excel list, filter active customers, mail a summary. -->
  <x:Members>
    <x:Property Name="in_ExcelPath" Type="InArgument(x:String)" />
    <x:Property Name="in_Recipient" Type="InArgument(x:String)" />
    <x:Property Name="out_ActiveCount" Type="OutArgument(x:Int32)" />
  </x:Members>
  <Sequence DisplayName="Main - Excel report mail" sap2010:Annotation.AnnotationText="Reads a customer list, counts active customers and sends a summary mail.">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dt_Customers" />
      <Variable x:TypeArguments="x:Int32" Name="int_Active" />
    </Sequence.Variables>
    <ui:LogMessage DisplayName="Log start" Level="Info" Message="[&quot;Start: Excel report mail&quot;]" />
    <TryCatch DisplayName="Try process report">
      <TryCatch.Try>
        <Sequence DisplayName="Process report">
          <ui:ExcelApplicationScope DisplayName="Excel Application Scope" WorkbookPath="[in_ExcelPath]">
            <ui:ExcelApplicationScope.Body>
              <ActivityAction x:TypeArguments="ui:WorkbookApplication">
                <ui:ExcelReadRange DisplayName="Read customer sheet" SheetName="Customers" Range="" AddHeaders="True" DataTable="[dt_Customers]" />
              </ActivityAction>
            </ui:ExcelApplicationScope.Body>
          </ui:ExcelApplicationScope>
          <Assign DisplayName="Count active customers">
            <Assign.To><OutArgument x:TypeArguments="x:Int32">[int_Active]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Int32">[dt_Customers.Select("Status = 'Active'").Length]</InArgument></Assign.Value>
          </Assign>
          <ui:SendOutlookMail DisplayName="Send summary mail" To="[in_Recipient]" Subject="[&quot;Customer report&quot;]" Body="[&quot;Active customers: &quot; + int_Active.ToString]" TimeoutMS="30000" />
          <Assign DisplayName="Set output">
            <Assign.To><OutArgument x:TypeArguments="x:Int32">[out_ActiveCount]</OutArgument></Assign.To>
            <Assign.Value><InArgument x:TypeArguments="x:Int32">[int_Active]</InArgument></Assign.Value>
          </Assign>
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" xmlns:s="clr-namespace:System;assembly=mscorlib">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="exception" /></ActivityAction.Argument>
            <Sequence DisplayName="Handle error">
              <ui:LogMessage DisplayName="Log error" Level="Error" Message="[&quot;Report failed: &quot; + exception.Message]" />
              <Rethrow DisplayName="Rethrow" />
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
    <ui:LogMessage DisplayName="Log end" Level="Info" Message="[&quot;End: Excel report mail&quot;]" />
  </Sequence>
</Activity>
